DEEPGRAM_API_KEY=            # required when STT_PROVIDER=deepgram
OPENAI_API_KEY=              # required (primary translation, minutes)
GEMINI_API_KEY=              # required (fallback translation)
# STT: deepgram (mặc định) | assemblyai (hỗ trợ tiếng Việt + chuyển ngữ giữa câu). Khóa của nhà cung cấp được chọn là bắt buộc
STT_PROVIDER=deepgram
ASSEMBLYAI_API_KEY=          # bắt buộc khi STT_PROVIDER=assemblyai
ASSEMBLYAI_MODEL=universal-3-6-pro
# Kênh im lặng quá ngần này ms thì không gửi audio lên STT (chỉ AssemblyAI; 0 = tắt cổng im lặng)
# STT_IDLE_AFTER_MS=30000
# Im lặng (ms) để AssemblyAI kết thúc lượt nói. Bỏ trống = mặc định theo ngôn ngữ (vi/multi 1200/3500, en 800/2500). Dùng để A/B
# ASSEMBLYAI_MIN_TURN_SILENCE_MS=
# ASSEMBLYAI_MAX_TURN_SILENCE_MS=
# Debug: ghi các frame thô của AssemblyAI ra JSONL để phát lại bằng tools/replay-segmenter (file hoặc thư mục, mỗi phiên 1 file). Bỏ trống = tắt
# RECAP_STT_CAPTURE=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi      # vi | en | multi
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_TRANSLATE_MODEL=gpt-4.1-mini
OPENAI_MINUTES_MODEL=gpt-4.1
# Cheap model that translates finished minutes into the other language (default gpt-4.1-mini, priced in config/pricing.json):
# OPENAI_MINUTES_TRANSLATE_MODEL=gpt-4.1-mini
# Minutes run in a worker inside apps/realtime (web only enqueues). All optional:
# MINUTES_WORKER_POLL_MS=1000
# MINUTES_WORKER_CONCURRENCY=1
# MINUTES_QUEUED_CLAIM_TIMEOUT_MS=120000

# Cửa sổ "đánh dấu kết luận" khi lập biên bản: bao nhiêu ms trước/sau lúc bấm (5000-300000 / 0-60000)
# MINUTES_MARK_WINDOW_BEFORE_MS=90000
# MINUTES_MARK_WINDOW_AFTER_MS=15000
TRANSLATE_PROVIDER_ORDER=openai,gemini
TRANSLATE_DEADLINE_MS=3000
TRANSLATE_FALLBACK_DEADLINE_MS=4000
REALTIME_PORT=4001
# Địa chỉ bind của realtime. Bỏ trống = mọi giao diện (dev). Production: 127.0.0.1 (chỉ reverse proxy truy cập được)
# REALTIME_HOST=127.0.0.1
# Origin được phép mở WebSocket (mặc định: localhost, 127.0.0.1, [::1]). Ví dụ: http://192.168.1.5:3000 hoặc *
REALTIME_ALLOWED_ORIGINS=
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001/ws
# Ngân sách chi phí API mỗi tháng (USD) hiển thị ở trang Usage
USAGE_MONTHLY_BUDGET_USD=60
# Hệ số nhân số tiền hiển thị cho người dùng (chỉ phía server, DB giữ giá thật). 1 = đúng giá ước tính
# USAGE_COST_DISPLAY_MULTIPLIER=1
DB_PATH=./data/recap.db
AUDIO_DIR=./data/audio
# Khóa ký cookie đăng nhập (>= 32 ký tự). Bắt buộc ở production; khi dev để trống sẽ tự sinh ra data/.auth-secret
AUTH_SECRET=
# Tùy chọn: token cho công cụ dòng lệnh (tools/stream-file) mở WebSocket không cần đăng nhập (>= 16 ký tự). Để trống = tắt
# RECAP_SERVICE_TOKEN=
# Chỉ đặt true khi chạy sau reverse proxy tin cậy (đọc X-Forwarded-For để giới hạn đăng nhập theo IP)
# AUTH_TRUST_PROXY=true
